<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UEHtheTeam.ChonMon"
             BackgroundColor="#F8FAF9"
             Title="ChonMon">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="20,10">
        <!-- Header: Nút back & Tag Học kỳ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="White">
                <Label Text="‹" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#111827"/>
            </Border>
            <Border Grid.Column="1" HorizontalOptions="End" BackgroundColor="#E6F4EA" Padding="12,6" StrokeShape="RoundRectangle 15" StrokeThickness="0">
                <Label Text="• Học kỳ 2 – 2024" TextColor="#137333" FontSize="12" FontAttributes="Bold"/>
            </Border>
        </Grid>

        <!-- Tiêu đề & Mô tả -->
        <StackLayout Grid.Row="1" Margin="0,15,0,15">
            <Label Text="Môn học học kỳ này" FontSize="22" FontAttributes="Bold" TextColor="#004D40"/>
            <Label Text="Nhập mã lớp học phần để ghép nhóm đúng lớp của bạn" TextColor="#6B7280" FontSize="13" Margin="0,5,0,0"/>
        </StackLayout>

        <!-- Subheader: Danh sách & Đã chọn -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
            <Label Grid.Column="0" Text="DANH SÁCH HỌC PHẦN" TextColor="#9CA3AF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
            <Border Grid.Column="1" BackgroundColor="#E6F4EA" Padding="10,4" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                <Label x:Name="somon" Text="Đã chọn 0 môn" TextColor="#137333" FontSize="11" FontAttributes="Bold"/>
            </Border>
        </Grid>

        <!-- Danh sách môn học -->
        <CollectionView x:Name="CoursesCollectionView" Grid.Row="3" VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 16" Stroke="#004D40" StrokeThickness="1.5" BackgroundColor="White">
                        <StackLayout>
                            <!-- Hàng 1: Badge Tín chỉ + Loại môn + Checkbox -->
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                <Border Grid.Column="0" BackgroundColor="{Binding TagBgColor}" Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                    <Label Text="{Binding Credits}" TextColor="{Binding TagTextColor}" FontSize="11" FontAttributes="Bold"/>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding CourseType}" TextColor="#6B7280" FontSize="12" VerticalOptions="Center" Margin="8,0,0,0"/>
                                <CheckBox Grid.Column="3" 
                                          IsChecked="{Binding IsSelected}" 
                                          CheckedChanged="OnCourseCheckedChanged" 
                                          Color="#004D40"/>
                            </Grid>

                            <!-- Hàng 2: Tên môn & Mã môn -->
                            <Label Text="{Binding CourseName}" FontAttributes="Bold" FontSize="15" TextColor="#111827" Margin="0,8,0,2"/>
                            <Label Text="{Binding Path=CourseCode, StringFormat='Mã môn: {0}'}" TextColor="#9CA3AF" FontSize="12"/>

                            <!-- Hàng 3: Ô nhập Mã lớp học phần -->
                            <Label Text="MÃ LỚP HỌC PHẦN" TextColor="#6B7280" FontSize="10" FontAttributes="Bold" Margin="0,12,0,4"/>
                            <Border BackgroundColor="#F3F4F6" Padding="12,0" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Entry Grid.Column="0" Placeholder="Nhập mã lớp (Ví dụ: ECO02)" FontSize="13" TextColor="#111827" PlaceholderColor="#9CA3AF"/>
                                    <Border Grid.Column="1" BackgroundColor="#E6F4EA" Padding="8,4" StrokeShape="RoundRectangle 6" StrokeThickness="0" VerticalOptions="Center">
                                        <Label Text="Khớp lớp ✓" TextColor="#137333" FontSize="11" FontAttributes="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Nút bấm cố định ở đáy -->
        <Button Grid.Row="4" Text="Hoàn tất &amp; Tìm nhóm 👥" BackgroundColor="#004D40" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>